# .env.example — copy to .env and fill in real values
# NEVER commit the real .env to version control

# ──────────────────────────────────────────────────────────────
# MetaTrader 5 credentials
# ──────────────────────────────────────────────────────────────
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# ──────────────────────────────────────────────────────────────
# Broker timezone (UTC offset of the broker server clock)
# EET/EEST (EU brokers): 2 or 3   |  UTC: 0  |  EST: -5
# ──────────────────────────────────────────────────────────────
SERVER_UTC_OFFSET_HOURS=2

# ──────────────────────────────────────────────────────────────
# Trading mode:  paper | live | backtest
# ──────────────────────────────────────────────────────────────
# SAFETY: the bot defaults to paper and only sends real orders when this is
# explicitly set to "live". Anything unrecognised falls back to paper.
# In paper mode, order submission/modification is simulated and nothing
# reaches the broker.
TRADING_MODE=paper

# Trading profile: balanced | money_printer | scalper
# - balanced: conservative swing trading (M15 / H1 / H4)
# - money_printer: multi-asset compounding scalper (M1 / M5 / M15)
# - scalper: ultra-fast microstructure scalper (M1 + EMA 9/21 ribbon + pinbars + tight 1.5 ATR SL)
TRADING_PROFILE=scalper

# Comma-separated list of markets to trade
TRADE_SYMBOLS=XAUUSDm,EURUSDm,BTCUSD

# ──────────────────────────────────────────────────────────────
# Database (SQLite only — local file persistence)
# ──────────────────────────────────────────────────────────────
# Default local SQLite database file:
DATABASE_URL=sqlite:///./data/trading.db


# ──────────────────────────────────────────────────────────────
# Application (docker compose)
# ──────────────────────────────────────────────────────────────
# Host port for the API. Bound to 127.0.0.1 only.
APP_PORT=8000

# ──────────────────────────────────────────────────────────────
# MT5 bridge (Windows 11 VM) — optional
# ──────────────────────────────────────────────────────────────
# The Linux core NEVER imports MetaTrader5. Broker access goes through an
# HTTP bridge on the Windows VM that hosts the MT5 terminal.
# Leave MT5_BRIDGE_URL empty to run with no broker connection at all.
#
# Discover the VM address with:  virsh domifaddr win11
# Verify reachability with:    curl http://<ip>:8100/api/health
# Do not hardcode a guessed address; the VM DHCP lease may change.
MT5_BRIDGE_URL=
# Shared secret sent as a Bearer token. Generate with: openssl rand -hex 32
# Must match MT5_BRIDGE_TOKEN on the Windows VM. Never commit a real value.
MT5_BRIDGE_TOKEN=
MT5_BRIDGE_TIMEOUT_SECONDS=10
# Leave TRUE unless using a self-signed lab certificate. Do not disable
# TLS verification as a routine workaround.
MT5_BRIDGE_TLS_VERIFY=true

# ──────────────────────────────────────────────────────────────
# LLM providers — leave empty to disable that provider
# ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local Ollama (no key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Which LLM provider to use: openai | anthropic | ollama | none
LLM_PROVIDER=none

# ──────────────────────────────────────────────────────────────
# Notifications
# ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────────
# Dashboard
# ──────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=change_me_to_a_long_random_string_before_deploying
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me

# ──────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ──────────────────────────────────────────────────────────────
# Risk defaults (override in Settings or dashboard)
# ──────────────────────────────────────────────────────────────
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
MAX_OPEN_POSITIONS=5
MIN_RR_RATIO=1.5
MAX_MARGIN_USAGE=0.50
MAGIC_NUMBER=888999

# ──────────────────────────────────────────────────────────────
# Strategy & Entry Sensitivity (Trading frequency)
# ──────────────────────────────────────────────────────────────
# ──────────────────────────────────────────────────────────────
# Strategy, Scalping & Entry Sensitivity
# ──────────────────────────────────────────────────────────────
# Execution timeframe: M1 (rapid 60s bars for scalping), M5, M15. Default: M15 (or M1 in money_printer)
TIMEFRAME=M15

# Multi-timeframe trend filters (leave empty to auto-cascade based on TIMEFRAME)
# For M1 execution: defaults to TREND_TF=M5 and MACRO_TREND_TF=M15
# For M15 execution: defaults to TREND_TF=H1 and MACRO_TREND_TF=H4
TREND_TF=
MACRO_TREND_TF=

# Minimum total confluence score to enter a trade (0-100). Default: 50 (or 38-45 in money_printer)
MIN_SIGNAL_SCORE=50

# Minimum AI confidence required to vote for a direction (0.50-1.0). Default: 0.55
AI_CONFIDENCE_THRESHOLD=0.55

# Minimum ADX trend strength (prevents trading in flat chop). Default: 18 (10 for scalping)
ADX_MIN=18

# Maximum allowable spread as a fraction of ATR (rejects trades when spread friction is > 20% of candle range)
MAX_SPREAD_ATR_RATIO=0.20

# Maximum trades per day. Default: 15 (60 for money_printer/scalper)
MAX_TRADES_PER_DAY=15

# Session filter: true = only London/NY sessions; false = trade anytime markets are open
USE_SESSION_FILTER=false

# ──────────────────────────────────────────────────────────────
# Progressive Breakeven & Profit Ratchet
# ──────────────────────────────────────────────────────────────
# Move SL to breakeven + buffer as soon as profit reaches this ATR multiple. Default: 0.4
BREAKEVEN_TRIGGER_ATR=0.4
# Profit buffer beyond entry to cover spread, commission, and swap. Default: 0.15
BREAKEVEN_BUFFER_ATR=0.15
# Progressive profit lock ratio (locks 50% of further gains continuously into SL). Default: 0.50
PROFIT_LOCK_RATIO=0.50
# Early partial close trigger in ATR multiples. Default: 1.2
PARTIAL_CLOSE_TRIGGER_ATR=1.2
# Peak profit giveback activation ATR multiple. Default: 1.0
PROFIT_LOCK_ACTIVATE_ATR=1.0
# Maximum giveback pct from peak profit before trailing exit. Default: 0.30
PROFIT_GIVEBACK_PCT=0.30
# Trailing activation ATR. Default: 1.0
TRAIL_ACTIVATE_ATR=1.0
# Trailing ATR distance. Default: 1.5
TRAIL_ATR_MULT=1.5
