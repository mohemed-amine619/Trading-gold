# ═══════════════════════════════════════════════════════════════════════════
# TRADING-GOLD · runtime environment
#
# SCALPER-STYLE PROFILE · M5 execution · live broker · XAUUSDm
#
# This file is read by run.py (the live bot) through python-dotenv. Every
# parameter declared in core/config/schema.py is present here on purpose: an
# explicitly written value always wins, so what you read is what the bot runs.
# Leaving a key OUT is also valid and falls back to the profile default.
#
# ⚠ TRADING_MODE=live sends REAL orders. Set TRADING_MODE=paper to simulate.
#
# ── CHANGES vs the version you pasted ──────────────────────────────────────
#  1. MAX_DAILY_DD 0.30 -> 0.05   (0.30 is outside the declared maximum 0.20
#     and made every dashboard "Apply All" fail validation; 0.05 is the
#     money_printer default. Ladder below: 5% day / 10% week / 20% total.)
#  2. TREND_TF M5 -> M15          (run.py refuses a trend TF <= the execution
#     TF and silently forced the default. M5/M5 was a no-op.)
#  3. MACRO_TREND_TF M15 -> H1    (same rule: must be higher than TREND_TF.)
#  4. GOLD_MIN_SIGNAL_SCORE=48    (NEW — on XAUUSDm this is the gate that
#     actually runs. MIN_SIGNAL_SCORE alone left it at 58.)
#  5. GOLD_MIN_AI_CONF=0.55       (NEW — gold's real AI gate. Your
#     AI_CONFIDENCE_THRESHOLD=0.50 never applied to gold; 0.50 is a coin flip.)
#  6. LLM_PROVIDER local_endpoint -> none. (This once said "embedded", a
#     built-in rule engine. That engine has been REMOVED: its confidence
#     numbers were hand-written constants, not measurements. 'none' means the
#     bot trades on technical confluence and structural stops, with no LLM.)
#  7. HISTORY_CANDLES 600 -> 1200 (the AI trained on 600 because min(history,
#     AI_TRAIN_BARS=800) capped it; 1200 lets it use the declared window.)
#  8. MAX_POS_PER_SYMBOL=1        (NEW — MAX_OPEN_POS=15 was a stacking ceiling,
#     and two identical XAUUSDm shorts were opened from one signal.)
#  9. MIN_SL_STEP_ATR=0.05        (NEW — only send a stop modify when it
#     improves the stop by >= 0.05 ATR, instead of one call per bar of drift.)
#  Inline comments moved onto their own lines and the leading spaces before
#  LOG_LEVEL / LLM_PROVIDER removed. Values were otherwise preserved.
# ═══════════════════════════════════════════════════════════════════════════

# ── Broker connection ───────────────────────────────────────────────────────
MT5_LOGIN=261009880
MT5_PASSWORD=Amine2002@
MT5_SERVER=Exness-MT5Trail16
MT5_PATH=

# Not read by run.py (config.py keeps this as a constant); kept as documentation.
SERVER_UTC_OFFSET_HOURS=2

# ── Mode ────────────────────────────────────────────────────────────────────
TRADING_MODE=paper
TRADING_PROFILE=scalper
TRADE_SYMBOLS=XAUUSDm
TRADE_SYMBOL=XAUUSDm

# ── Ports, isolation, storage ───────────────────────────────────────────────
DASHBOARD_PORT=8001
# APP_PORT is not read by run.py; DASHBOARD_PORT is the one that binds.
APP_PORT=8001
MAGIC_NUMBER=888992
DATABASE_URL=sqlite:///./data/trading.db
RISK_STATE_DIR=data/state

# Optional write-auth for the dashboard. Uncomment and set to require
# X-Dashboard-Token on every mutating /api/* call. Reads stay open either way.
# DASHBOARD_TOKEN=

# Used by core/settings.py (modular engine) for its live-trading check,
# not by run.py. Rotate it: it was pasted into a chat.
DASHBOARD_SECRET_KEY=33f83282b2bdc025a3c5722709a7a48191231d907083a4865a44479da4471a6c

# ── Risk controls ───────────────────────────────────────────────────────────
RISK_PER_TRADE=0.0075
MAX_DAILY_DD=0.05
MAX_WEEKLY_DD=0.10
MAX_TOTAL_DD=0.20
MAX_OPEN_POS=3
# NEW: one idea, one position. MAX_OPEN_POS alone allowed the same signal to
# re-fire on the next bar and open an identical position (observed live: two
# identical XAUUSDm shorts). This caps each symbol independently.
MAX_POS_PER_SYMBOL=1
MAX_MARGIN_USAGE=0.35
MAX_TRADES_PER_DAY=30
MAX_CONSECUTIVE_LOSSES=4
LOSS_STREAK_COOLDOWN_MIN=60
DYNAMIC_RISK=true
MIN_RISK_SCALE=0.50
MAX_RISK_SCALE=1.00
EQUITY_PROTECT_CLOSE_ALL=true
REDUCE_SIZE_AT_DD=0.50
HALT_AT_DD=0.80

# ── Execution & confluence (M5) ─────────────────────────────────────────────
TIMEFRAME=M5
TREND_TF=M15
MACRO_TREND_TF=H1
HISTORY_CANDLES=1200
MIN_SIGNAL_SCORE=48
GOLD_MIN_SIGNAL_SCORE=48
AI_CONFIDENCE_THRESHOLD=0.50
GOLD_MIN_AI_CONF=0.55
ADX_MIN=18
ADX_STRONG=25
MAX_SPREAD_ATR_RATIO=0.20
MAX_SPREAD_POINTS=0
USE_SESSION_FILTER=true
LONDON_START_UTC=7
LONDON_END_UTC=16
NY_START_UTC=12
NY_END_UTC=21

# ── Stops & targets ─────────────────────────────────────────────────────────
SL_ATR_MULT=1.3
TP_RR_RATIO=2.0
LOCATION_STOP=true
LOCATION_STOP_MIN_ATR=0.75
LOCATION_STOP_MAX_ATR=2.50
LOCATION_TARGET=true
LOCATION_GATE=true
STRICT_LOCATION_VETO=true

# ── Trade management ────────────────────────────────────────────────────────
TRAIL_ATR_MULT=1.00
TRAIL_ACTIVATE_ATR=1.10
TRAIL_TIGHTEN1_ATR=1.50
TRAIL_TIGHTEN1_MULT=0.80
TRAIL_TIGHTEN2_ATR=2.20
TRAIL_TIGHTEN2_MULT=0.50
STRUCTURE_TRAILING=true
MIN_SL_SEPARATION_ATR=0.55
# NEW: minimum stop improvement per modify, in ATR. Damped the ~1-point
# ratchet churn seen live (4027.436 -> 4027.425). 0 = old every-move behaviour.
MIN_SL_STEP_ATR=0.05
ENABLE_BREAKEVEN=true
BREAKEVEN_TRIGGER_ATR=0.90
BREAKEVEN_BUFFER_ATR=0.20
PROFIT_LOCK_RATIO=0.60
PROFIT_LOCK_ACTIVATE_ATR=1.20
PROFIT_GIVEBACK_PCT=0.35
ENABLE_PARTIAL_CLOSE=true
PARTIAL_CLOSE_TRIGGER_ATR=1.20
SCALP_MICRO_TRAILING=true

# ── Strategies ──────────────────────────────────────────────────────────────
FIB_ENABLED=true
FIB_WEIGHT=10
FIB_ZONE_LOW=0.382
FIB_ZONE_HIGH=0.786
FIB_EXTENSION_TARGET=1.618
TREND_WEIGHT=30
MOMENTUM_WEIGHT=15

# ── Dynamic AI SL/TP & reasoning ────────────────────────────────────────────
# LLM_PROVIDER=none means NO large language model. Stops and targets are still
# planned from market structure; an LLM only ever refines a plan that already
# exists. The old 'embedded' engine was removed: it keyword-matched the prompt
# and returned hand-written confidence numbers (86.0, 91.0, 92.0) that were
# logged as AI confidence without anything having been measured.
# 'embedded' is still accepted and resolves to none, so an old .env keeps working.
# To use a real local model, run LM Studio / vLLM and set:
#   LLM_PROVIDER=local_endpoint  (plus LOCAL_LLM_URL / LOCAL_LLM_MODEL below)
DYNAMIC_SLTP_ENABLED=true
LLM_CRITIC_ENABLED=true
LLM_PROVIDER=none
LOCAL_LLM_URL=http://localhost:1235/v1
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_TIMEOUT=3.0

# ── Neural network (the local model that actually learns) ───────────────────
# NN_MIN_CONFIDENCE is the MINIMUM of the trainer's validation threshold
# search, not a safety setting. The trainer scans [NN_MIN_CONFIDENCE, 0.90] and
# keeps the threshold with the best edge lower bound among those with >= 30
# non-overlapping trades; the predictor then votes at the threshold where the
# edge was actually measured.
#
# It must stay BELOW what a calibrated model can reach (~0.80 on noisy M5), or
# every threshold scores 0 trades, the edge is "unmeasured", and no model is
# ever promoted. At 0.72 that is exactly what happened on every symbol.
NN_ENABLED=true
NN_TRAINER_ENABLED=true
NN_MIN_CONFIDENCE=0.55
# Refuse a model whose measured out-of-sample edge is below this. 0.0 = must
# simply be measurably positive and beat the naive always-long/always-short
# baseline. Raise it to demand a bigger proven edge.
NN_MIN_OOS_EDGE=0.0
# More bars = more non-overlapping holdout trades = an edge that can be
# measured at all. 30000 M5 bars is about 100 trading days.
NN_TRAINER_BARS=30000
NN_TRAINER_INTERVAL_MIN=60

# ── AI model validation & sizing ────────────────────────────────────────────
# A challenger model replaces the live one only if it beats the trivial
# "always guess the majority class" baseline out of sample. AI_MIN_OOS_EDGE=0.0
# refuses a model with no measurable edge — the bot then reports "not promoted"
# and trades without the AI component. That is correct, not a malfunction.
AI_ENABLED=true
AI_TRAIN_BARS=800
AI_RETRAIN_BARS=50
AI_VALIDATION_FRACTION=0.20
AI_MIN_OOS_ACCURACY=0.52
AI_MIN_OOS_AUC=0.50
AI_MIN_OOS_EDGE=0.0
AI_PROMOTE_TOLERANCE=0.01
AI_CALIBRATE=true
AI_MIN_EDGE_FOR_SIZE_UP=0.20
AI_SIZE_HIGH_CONF=0.70
AI_SIZE_LOW_CONF=0.60
AI_MODEL_PERSIST=true

# ── Execution & manual trades ───────────────────────────────────────────────
DEVIATION=20
SLEEP_INTERVAL=1.0
DEFAULT_MANUAL_POLICY=observe_only
AI_PROTECT_MANUAL_TRADES=true
MANUAL_TRADE_SL_ATR=2.0

# ── System (read by config.py, not run.py) ──────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
