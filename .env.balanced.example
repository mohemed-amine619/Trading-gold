# ==============================================================
# WINDOW 1: BALANCED SWING & TREND CONFLUENCE (Example Template)
# Copy to .env.balanced and fill in MT5 credentials
# ==============================================================
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trail16
MT5_PATH=
SERVER_UTC_OFFSET_HOURS=2

TRADING_MODE=live
TRADING_PROFILE=balanced
TRADE_SYMBOLS=XAUUSDm

# Ports & Isolation
APP_PORT=8000
DASHBOARD_PORT=8000
MAGIC_NUMBER=888991
DATABASE_URL=sqlite:///./trading.db

# Risk Controls
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
MAX_OPEN_POSITIONS=3
MAX_MARGIN_USAGE=0.30
MAX_RISK_SCALE=1.0

# Execution & Confluence (M5 Swing)
TIMEFRAME=M5
TREND_TF=M15
MACRO_TREND_TF=H1
MIN_SIGNAL_SCORE=58
AI_CONFIDENCE_THRESHOLD=0.55
ADX_MIN=20
MAX_SPREAD_ATR_RATIO=0.25
MAX_TRADES_PER_DAY=15
USE_SESSION_FILTER=false

# Exits & Trailing (High Reward : Low Risk)
SL_ATR_MULT=1.4
TP_RR_RATIO=2.5
BREAKEVEN_TRIGGER_ATR=1.10
BREAKEVEN_BUFFER_ATR=0.25
PROFIT_LOCK_RATIO=0.50
PARTIAL_CLOSE_TRIGGER_ATR=1.50
PROFIT_LOCK_ACTIVATE_ATR=1.50
PROFIT_GIVEBACK_PCT=0.40
TRAIL_ACTIVATE_ATR=1.40
TRAIL_ATR_MULT=1.20

# System
LOG_LEVEL=INFO
LOG_DIR=logs
LLM_PROVIDER=none
