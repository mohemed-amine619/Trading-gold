# ==============================================================
# WINDOW 2: FAST-PACED SCALPER (M1 Microstructure) (Example Template)
# Copy to .env.scalper and fill in MT5 credentials
# ==============================================================
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trail16
MT5_PATH=
SERVER_UTC_OFFSET_HOURS=2

TRADING_MODE=live
TRADING_PROFILE=scalper
TRADE_SYMBOLS=XAUUSDm

# Ports & Isolation
APP_PORT=8001
DASHBOARD_PORT=8001
MAGIC_NUMBER=888992
DATABASE_URL=sqlite:///./trading.db

# Risk Controls (Tighter risk for higher frequency)
RISK_PER_TRADE=0.0075
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
MAX_OPEN_POSITIONS=3
MAX_MARGIN_USAGE=0.35
MAX_RISK_SCALE=1.0

# Execution & Confluence (M1 Scalp)
TIMEFRAME=M1
TREND_TF=M5
MACRO_TREND_TF=M15
MIN_SIGNAL_SCORE=48
AI_CONFIDENCE_THRESHOLD=0.50
ADX_MIN=18
MAX_SPREAD_ATR_RATIO=0.20
MAX_TRADES_PER_DAY=30
USE_SESSION_FILTER=false

# Exits & Trailing (Quick targets, safely above broker spread)
SL_ATR_MULT=1.3
TP_RR_RATIO=2.0
BREAKEVEN_TRIGGER_ATR=0.90
BREAKEVEN_BUFFER_ATR=0.20
PROFIT_LOCK_RATIO=0.60
PARTIAL_CLOSE_TRIGGER_ATR=1.20
PROFIT_LOCK_ACTIVATE_ATR=1.20
PROFIT_GIVEBACK_PCT=0.35
TRAIL_ACTIVATE_ATR=1.10
TRAIL_ATR_MULT=1.00

# System
LOG_LEVEL=INFO
LOG_DIR=logs
LLM_PROVIDER=none
