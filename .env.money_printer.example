# ==============================================================
# WINDOW 3: HIGH-PERFORMANCE COMPOUNDING (Money Printer) (Example Template)
# Copy to .env.money_printer and fill in MT5 credentials
# ==============================================================
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trail16
MT5_PATH=
SERVER_UTC_OFFSET_HOURS=2

TRADING_MODE=live
TRADING_PROFILE=money_printer
TRADE_SYMBOLS=XAUUSDm

# Ports & Isolation
APP_PORT=8002
DASHBOARD_PORT=8002
MAGIC_NUMBER=888993
DATABASE_URL=sqlite:///./trading.db

# Risk Controls
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.10
MAX_OPEN_POSITIONS=5
MAX_MARGIN_USAGE=0.45
MAX_RISK_SCALE=1.2

# Execution & Confluence (M5 Momentum Compounding)
TIMEFRAME=M5
TREND_TF=M15
MACRO_TREND_TF=H1
MIN_SIGNAL_SCORE=52
AI_CONFIDENCE_THRESHOLD=0.55
ADX_MIN=22
MAX_SPREAD_ATR_RATIO=0.25
MAX_TRADES_PER_DAY=25
USE_SESSION_FILTER=false

# Exits & Trailing (Compounding Runner Strategy)
SL_ATR_MULT=1.5
TP_RR_RATIO=2.2
BREAKEVEN_TRIGGER_ATR=1.00
BREAKEVEN_BUFFER_ATR=0.25
PROFIT_LOCK_RATIO=0.55
PARTIAL_CLOSE_TRIGGER_ATR=1.40
PROFIT_LOCK_ACTIVATE_ATR=1.40
PROFIT_GIVEBACK_PCT=0.35
TRAIL_ACTIVATE_ATR=1.30
TRAIL_ATR_MULT=1.10

# System
LOG_LEVEL=INFO
LOG_DIR=logs
LLM_PROVIDER=none
