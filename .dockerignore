# Version control
.git
.gitignore
.github

# Secrets — never bake credentials into an image
.env
.env.*
!.env.example
*.pem
*.key

# Virtual environments (host venvs are not needed inside the image)
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local databases and WAL sidecars (the container uses PostgreSQL)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
trading.db*

# Logs
logs/
*.log

# Windows / desktop artefacts
Thumbs.db
ehthumbs.db
*.bat
*.spec
get-pip.py

# Documentation and tooling not required at runtime
docs/
.gitignore
AGENTS.md
*.md

# Docker files themselves
Dockerfile
.dockerignore
compose.yaml
# Windows-only MT5 bridge service (see docs/MT5_WINDOWS_BRIDGE.md).
# The Ubuntu image must never contain it.
bridge/
